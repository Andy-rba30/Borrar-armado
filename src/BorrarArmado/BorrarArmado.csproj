<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Plugin de Revit: Borrar Armado
    Compila para varias versiones de Revit con una configuración por versión:
      dotnet build -c "Release R2027"
      dotnet build -c "Release R2025"
    Revit 2021-2024 -> .NET Framework 4.8
    Revit 2025-2026 -> .NET 8 (windows)
    Revit 2027      -> .NET 10 (windows)
  -->

  <PropertyGroup>
    <RootNamespace>BorrarArmado</RootNamespace>
    <AssemblyName>BorrarArmado</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <Product>Borrar Armado</Product>
    <Description>Elimina todo el armado de acero (barras, mallas, refuerzos de área y trayectoria) de los elementos seleccionados en Revit.</Description>
    <Configurations>Debug R2021;Debug R2022;Debug R2023;Debug R2024;Debug R2025;Debug R2026;Debug R2027;Release R2021;Release R2022;Release R2023;Release R2024;Release R2025;Release R2026;Release R2027</Configurations>
  </PropertyGroup>

  <!-- Versión de Revit y framework según la configuración elegida -->
  <PropertyGroup Condition="$(Configuration.Contains('R2021'))">
    <RevitVersion>2021</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2022'))">
    <RevitVersion>2022</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2023'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2024'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2025'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2026'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R2027'))">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Si se compila con "Debug"/"Release" a secas, usar Revit 2027 por defecto -->
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <RevitVersion>2027</RevitVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize Condition="$(Configuration.Contains('Release'))">true</Optimize>
    <DebugType Condition="$(Configuration.Contains('Debug'))">full</DebugType>
    <DebugType Condition="$(Configuration.Contains('Release'))">portable</DebugType>
  </PropertyGroup>

  <!-- Ensamblados de la API de Revit (no requieren Revit instalado para compilar) -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <None Include="BorrarArmado.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tras compilar, copia el plugin a la carpeta de Addins del usuario (solo Windows) -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <AddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <AddinBinaries Include="$(OutDir)$(AssemblyName).dll" />
      <AddinBinaries Include="$(OutDir)$(AssemblyName).pdb" Condition="Exists('$(OutDir)$(AssemblyName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinBinaries)" DestinationFolder="$(AddinsDir)$(AssemblyName)\" ContinueOnError="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BorrarArmado.addin" DestinationFolder="$(AddinsDir)" ContinueOnError="true" />
    <Message Importance="high" Text="BorrarArmado desplegado en $(AddinsDir)" />
  </Target>

</Project>
